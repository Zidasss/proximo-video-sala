# =============================================================================
# Klip — variáveis de ambiente
# Copie para `.env.local` (nunca commite esse arquivo: `.env*` está no .gitignore)
# =============================================================================

# URL pública do app. Precisa bater EXATAMENTE com os redirect URIs cadastrados
# no Google e no Meta. Em produção use https://.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase (auth, tabela social_accounts, storage dos vídeos)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# YouTube — Google Cloud Console (console.cloud.google.com)
#   1. Crie um projeto e ative a "YouTube Data API v3"
#   2. Tela de consentimento OAuth: escopos youtube.upload + youtube.readonly
#   3. Credenciais > ID do cliente OAuth > Aplicativo da Web
#   4. Redirect URI autorizado:
#        http://localhost:3000/api/auth/callback/youtube
#        https://SEU-DOMINIO/api/auth/callback/youtube
#
#   Atenção: enquanto o app estiver em "Teste"/não verificado pelo Google, os
#   vídeos enviados ficam travados como "private" (restrição de apps não
#   verificados). Para publicar em "public" é preciso passar pela verificação
#   e pela auditoria de conformidade da YouTube API.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Categoria padrão dos Shorts (22 = People & Blogs, 20 = Gaming, 10 = Music)
YOUTUBE_CATEGORY_ID=22

# -----------------------------------------------------------------------------
# Instagram Reels — Meta for Developers (developers.facebook.com)
#   1. Crie um app do tipo "Business"
#   2. Adicione os produtos "Facebook Login" e "Instagram Graph API"
#   3. Permissões: instagram_basic, instagram_content_publish,
#      pages_show_list, pages_read_engagement, business_management
#   4. Redirect URI válido do OAuth:
#        https://SEU-DOMINIO/api/auth/callback/instagram
#
#   Pré-requisitos da conta que vai publicar:
#     - perfil do Instagram convertido para Business ou Creator
#     - vinculado a uma Página do Facebook
#     - o usuário que autoriza precisa ser admin dessa Página
#
#   Fora do modo de desenvolvimento, o app precisa passar pela App Review da
#   Meta para usar instagram_content_publish com contas de terceiros.
# -----------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=

# Versão da Graph API usada nas chamadas (padrão: v23.0)
META_GRAPH_VERSION=v23.0

# -----------------------------------------------------------------------------
# TikTok — TikTok for Developers (developers.tiktok.com)
#   Escopos: user.info.basic, video.upload, video.publish
#   Redirect URI: https://SEU-DOMINIO/api/auth/callback/tiktok
# -----------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Desenvolvimento
# -----------------------------------------------------------------------------
# Com "true", nenhuma chamada real é feita às plataformas: a publicação é
# simulada e devolve IDs falsos. Útil para testar a UI do multi-post.
ENABLE_PUBLISH_MOCK=false
