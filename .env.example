# =============================================================================
# KLIPAPP — variáveis de ambiente
# Copie para `.env.local`. Nunca versione `.env.local` ou qualquer secret.
# Produção oficial: https://www.klipapp.com.br
# =============================================================================

# URL pública desta execução, sem barra no fim.
# Desenvolvimento:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Na Vercel/produção, configure exatamente:
# NEXT_PUBLIC_APP_URL=https://www.klipapp.com.br

# -----------------------------------------------------------------------------
# Supabase — conta, sessão, perfil, social_accounts e Storage
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LOGIN GOOGLE VIA SUPABASE (não usa /api/auth/callback/youtube)
#
# 1. Supabase > Authentication > URL Configuration
#      Site URL:     https://www.klipapp.com.br
#      Redirect URL: https://www.klipapp.com.br/auth/callback
#      Local:        http://localhost:3000/auth/callback
#
# 2. Google Cloud > cliente OAuth usado pelo provedor Google do Supabase
#      URI de redirecionamento autorizado:
#      https://<PROJECT_REF>.supabase.co/auth/v1/callback
#
#    Projeto Supabase atual:
#      https://kglzsruwwapvppkpcpaz.supabase.co/auth/v1/callback
#
# O callback `www.klipapp.com.br/auth/callback` é cadastrado no Supabase.
# O callback `supabase.co/auth/v1/callback` é cadastrado no Google Cloud.

# -----------------------------------------------------------------------------
# YouTube — conexão de canal e publicação (OAuth separado do login Google)
# -----------------------------------------------------------------------------
# Google Cloud:
#   1. Ative a YouTube Data API v3.
#   2. Configure os escopos youtube.upload e youtube.readonly.
#   3. Crie um cliente OAuth do tipo Aplicativo da Web.
#   4. Cadastre estes URIs autorizados:
#        http://localhost:3000/api/auth/callback/youtube
#        https://www.klipapp.com.br/api/auth/callback/youtube
#
# Estas credenciais pertencem à publicação no YouTube. O login Google da conta
# KLIPAPP é configurado no provedor Google do Supabase, descrito acima.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Categoria padrão dos Shorts: 22 People & Blogs, 20 Gaming, 10 Music.
YOUTUBE_CATEGORY_ID=22

# Apps Google não verificados podem ter uploads limitados a `private`. A
# publicação pública exige a verificação e, quando aplicável, a auditoria da API.

# -----------------------------------------------------------------------------
# Instagram Reels — Meta for Developers
# -----------------------------------------------------------------------------
# App Business com Facebook Login e Instagram Graph API.
# Redirect URI de produção:
#   https://www.klipapp.com.br/api/auth/callback/instagram
# Redirect local, se estiver cadastrado no app Meta:
#   http://localhost:3000/api/auth/callback/instagram
#
# Permissões:
#   instagram_basic, instagram_content_publish, pages_show_list,
#   pages_read_engagement, business_management
#
# A conta precisa ser Business ou Creator, estar ligada a uma Página do
# Facebook e ser autorizada por um administrador dessa Página.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0

# -----------------------------------------------------------------------------
# TikTok — TikTok for Developers
# -----------------------------------------------------------------------------
# Crie um app e adicione o produto Content Posting API.
# Escopos: user.info.basic, video.upload, video.publish
# Redirect URI de produção:
#   https://www.klipapp.com.br/api/auth/callback/tiktok
# Redirect local, se estiver cadastrado no app TikTok:
#   http://localhost:3000/api/auth/callback/tiktok
#
# O app usa FILE_UPLOAD. PULL_FROM_URL exigiria comprovar a propriedade do
# domínio do Supabase Storage, que pertence a um terceiro.
#
# Antes da auditoria, o TikTok limita a publicação a SELF_ONLY. A KLIPAPP lê
# creator_info e ajusta a visibilidade automaticamente em vez de falhar.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Com "true", os videos vao para os RASCUNHOS do app do TikTok em vez de serem
# publicados direto no feed. Util enquanto o app nao e auditado.
TIKTOK_POST_AS_DRAFT=false

# -----------------------------------------------------------------------------
# Desenvolvimento e testes de publicação
# -----------------------------------------------------------------------------
# `true` impede chamadas reais às redes e devolve IDs simulados. Autenticação,
# chamada, gravação e edição continuam funcionando normalmente.
ENABLE_PUBLISH_MOCK=false
